  <property name="styleSheet">
   <string notr="true">/* =========================
   Clinical Theme - Unified Buttons
   ========================= */

QMainWindow {
    background-color: #f3f6fa;
    color: #1f2937;
    font-family: &quot;Segoe UI&quot;;
    font-size: 11px;
}

QWidget#centralwidget {
    background-color: #f3f6fa;
}

/* Menu + status */
QMenuBar {
    background-color: #ffffff;
    color: #334155;
    border-bottom: 1px solid #dbe1e8;
    padding: 1px 6px;
}
QMenuBar::item {
    padding: 5px 8px;
    border-radius: 3px;
}
QMenuBar::item:selected {
    background-color: #eef2f7;
}
QMenu {
    background-color: #ffffff;
    color: #334155;
    border: 1px solid #dbe1e8;
}
QMenu::item {
    padding: 6px 14px;
}
QMenu::item:selected {
    background-color: #eef2f7;
}
QStatusBar {
    background-color: #ffffff;
    color: #64748b;
    border-top: 1px solid #dbe1e8;
}

/* Containers */
QWidget#sideBar,
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #dbe1e8;
    border-radius: 4px;
}
QGroupBox {
    margin-top: 10px;
    padding: 8px;
    color: #334155;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #475569;
}


/* Labels */
QLabel {
    color: #475569;
    font-weight: 600;
}

/* Lists */
QListWidget {
    background-color: #ffffff;
    border: 1px solid #d6dde6;
    border-radius: 3px;
    padding: 2px;
    outline: none;
}
QListWidget::item {
    padding: 5px 6px;
    border-radius: 2px;
    color: #1f2937;
}
QListWidget::item:hover {
    background-color: #f2f5f9;
}
QListWidget::item:selected {
    background-color: #dbe7f7;
    color: #0f172a;
}

/* Inputs */
QTextEdit,
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #cfd8e3;
    border-radius: 3px;
}
QTextEdit {
    padding: 5px;
}
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    min-height: 22px;
    padding: 2px 6px;
}
QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus,
QTextEdit:focus {
    border: 1px solid #5b8cc9;
}
QComboBox::drop-down {
    width: 18px;
    border: none;
}

/* ALL buttons unified to play style (slightly lighter) */
QPushButton {
    background-color: #178a82;
    color: #f8fafc;
    border: 1px solid #14736d;
    border-radius: 6px;
    padding: 3px 10px;
    min-height: 22px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #1aa097;
    border-color: #168982;
}
QPushButton:pressed {
    background-color: #136e68;
    border-color: #105a55;
}
QPushButton:disabled {
    background-color: #8aa8a5;
    color: #e5e7eb;
    border-color: #7c9a97;
}

/* Keep transport compact but same style */
QPushButton#jumpstartButton,
QPushButton#jumpBehindButton,
QPushButton#playButton,
QPushButton#jumpAheadButton,
QPushButton#jumpEndButton {
    min-width: 38px;
    max-width: 44px;
    min-height: 24px;
    max-height: 24px;
    padding: 0px;
    font-size: 13px;
    font-weight: 600;
}

/* Optional: play a touch darker than others */
QPushButton#playButton {
    background-color: #0f766e;
    border-color: #0d5f59;
}
QPushButton#playButton:hover {
    background-color: #11867d;
}
QPushButton#playButton:pressed {
    background-color: #0c615b;
}

/* Sliders */
QSlider::groove:horizontal {
    height: 4px;
    background: #d3dce7;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 10px;
    margin: -4px 0;
    background: #6b8fb6;
    border: 1px solid #587da6;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: #aac0d9;
    border-radius: 2px;
}

QSlider::groove:vertical {
    width: 4px;
    background: #d3dce7;
    border-radius: 2px;
}
QSlider::handle:vertical {
    height: 10px;
    margin: 0 -4px;
    background: #6b8fb6;
    border: 1px solid #587da6;
    border-radius: 2px;
}
QSlider::sub-page:vertical {
    background: #aac0d9;
    border-radius: 2px;
}

/* Audio slider contrast on dark box */
QGroupBox#audioBox QSlider::groove:horizontal,
QGroupBox#audioBox QSlider::groove:vertical {
    background: #3a4658;
}
QGroupBox#audioBox QSlider::sub-page:horizontal,
QGroupBox#audioBox QSlider::sub-page:vertical {
    background: #6b8fb6;
}
QGroupBox#audioBox QSlider::handle:horizontal,
QGroupBox#audioBox QSlider::handle:vertical {
    background: #c7d3e2;
    border: 1px solid #9eb2c9;
}</string>
